{
	"name": "chat-notes",
	"version": "1.1.1",
	"description": "Write messages, chats and conversations inside your Obsidian notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "9.30.1",
		"@types/node": "^22.20.1",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.11"
	}
}
